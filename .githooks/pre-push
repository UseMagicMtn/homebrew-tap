#!/bin/sh
set -eu

while read -r local_ref local_oid remote_ref remote_oid; do
    if ! tip=$(git rev-parse --verify --quiet "${local_oid}^{commit}"); then
        continue
    fi
    if base=$(git rev-parse --verify --quiet "${remote_oid}^{commit}"); then
        commits=$(git rev-list "$base..$tip")
    else
        commits=$(git rev-list "$tip")
    fi
    for commit in $commits; do
        if ! git verify-commit "$commit" >/dev/null 2>&1; then
            printf 'Push blocked: commit %s for %s has no verifiable signature.\n' "$commit" "$remote_ref" >&2
            exit 1
        fi
    done
done
